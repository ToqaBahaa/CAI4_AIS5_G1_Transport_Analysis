				"content": {
					"query": "CREATE VIEW vw_peak_hours AS\nWITH trips AS (\n    SELECT *\n    FROM OPENROWSET(\n        BULK 'https://adlstransproject.dfs.core.windows.net/transportationdata/curated_parquet/trips/**',\n        FORMAT = 'PARQUET'\n    ) AS t\n)\nSELECT\n    hour_of_day,\n    SUM(passenger_count) AS total_passengers,\n    COUNT(*) AS total_trips\nFROM trips\nGROUP BY hour_of_day;",
