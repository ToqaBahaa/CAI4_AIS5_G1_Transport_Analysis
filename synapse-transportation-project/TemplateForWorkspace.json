		{
			"name": "[concat(parameters('workspaceName'), '/TripAnalysis')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "\nCREATE VIEW vw_weekday_weekend_demand AS\n\nWITH trips AS (\n    SELECT *\n    FROM OPENROWSET(\n        BULK 'https://adlstransproject.dfs.core.windows.net/transportationdata/curated_parquet/trips/**',\n        FORMAT = 'PARQUET'\n    ) AS t\n),\nroutes AS (\n    SELECT *\n    FROM OPENROWSET(\n        BULK 'https://adlstransproject.dfs.core.windows.net/transportationdata/curated_parquet/routes/**',\n        FORMAT = 'PARQUET'\n    ) AS r\n),\nstations AS (\n    SELECT *\n    FROM OPENROWSET(\n        BULK 'https://adlstransproject.dfs.core.windows.net/transportationdata/curated_parquet/stations/**',\n        FORMAT = 'PARQUET'\n    ) AS s\n),\ntrip_analysis AS (\n    SELECT\n        t.trip_id,\n        t.route_id,\n        r.route_name,\n        t.pickup_station,\n        t.dropoff_station,\n        t.pickup_zone,\n        t.dropoff_zone,\n        t.passenger_count,\n        t.fare_egp,\n        t.trip_distance_km,\n        t.payment_method,\n        t.trip_datetime,\n        t.hour_of_day,\n        t.day_of_week,\n\n        CASE\n            WHEN t.day_of_week IN ('Friday', 'Saturday')\n                THEN 'Weekend'\n            ELSE 'Weekday'\n        END AS trip_period\n\n    FROM trips t\n\n    LEFT JOIN routes r\n        ON t.route_id = r.route_name\n)\n\nSELECT\n    trip_period,\n    pickup_zone,\n\n    COUNT(DISTINCT trip_id) AS total_trips,\n\n    SUM(passenger_count) AS total_passengers,\n\n    ROUND(SUM(fare_egp * passenger_count), 2) AS total_revenue,\n\n    MIN(hour_of_day) AS first_active_hour,\n\n    MAX(hour_of_day) AS last_active_hour\n\nFROM trip_analysis\n\nGROUP BY\n    trip_period,\n    pickup_zone\n\nHAVING COUNT(*) > 10;",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "transportdb",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
