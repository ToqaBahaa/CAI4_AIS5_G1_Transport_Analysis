						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get trips",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Get stations",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Get routes",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(\n    and(\n        activity('Get trips').output.exists,\n        activity('Get stations').output.exists\n    ),\n    and(\n        activity('Get routes').output.exists,\n        greater(activity('Get trips').output.size,1000000)\n    )\n)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail1",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Trips file too small",
								"errorCode": "FILE_TOO_SMALL"
							}
						}
					],
					"ifTrueActivities": [
